AWS_REGION=us-east-1
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-pro-v1:0
AWS_CA_BUNDLE=
REQUESTS_CA_BUNDLE=

LOCAL_RAG_ENABLED=true
LOCAL_RAG_DOC_PATH=apps/api/docs/sta.md
LOCAL_RAG_MAX_CHUNKS=5
LOCAL_RAG_CHUNK_SIZE=2500

PUBLIC_DOC_LOOKUP_ENABLED=true
PUBLIC_DOC_MAX_URLS=6
PUBLIC_DOC_MAX_URLS_PER_QUERY=3
PUBLIC_DOC_URLS=https://thalesdocs.com/sta/,https://docs.thalesgroup.com/,https://docs-cybersec.thalesgroup.com/
PUBLIC_DOC_CACHE_TTL_SECONDS=900
COMBINED_CONTEXT_MAX_CHARS=18000
CHAT_REQUEST_TIMEOUT_SECONDS=60
PUBLIC_DOC_TIMEOUT_SECONDS=5
BEDROCK_TIMEOUT_SECONDS=45

TICKET_API_MODE=zammad
TICKET_API_URL=
TICKET_API_METHOD=POST
TICKET_API_AUTH_TYPE=bearer
TICKET_API_TOKEN=
TICKET_API_EXTRA_HEADER_NAME=
TICKET_API_EXTRA_HEADER_VALUE=

# Execução local direta (WSL/Python):
ZAMMAD_BASE_URL=http://localhost:8080
# Docker Compose: comente a linha acima e use a linha abaixo.
# ZAMMAD_BASE_URL=http://host.docker.internal:8080
ZAMMAD_API_TOKEN=
ZAMMAD_GROUP=Suporte
ZAMMAD_CUSTOMER_EMAIL=cliente@empresa.com.br
ZAMMAD_CUSTOMER_NAME=Cliente Demonstração
ZAMMAD_TECHNICIAN_EMAIL=tecnico@neoia.local
ZAMMAD_TICKET_STATE=new
ZAMMAD_TICKET_PRIORITY=2 normal
# Espaços e aspas externas acidentais são normalizados pela API. Informe o e-mail
# como endereço simples, sem Markdown, por exemplo: cliente@empresa.com.br.

EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_SUBJECT_PREFIX=[NeoIASecurity]
NOTIFY_REQUESTER=true
NOTIFY_TECHNICIAN=true
REQUESTER_EMAIL=cliente@empresa.com.br
TECHNICIAN_EMAIL=tecnico@neoia.local

OCTADESK_API_URL=https://api.octadesk.services
OCTADESK_ACCESS_TOKEN=
OCTADESK_AGENT_EMAIL=
OCTADESK_REQUESTER_EMAIL=test.requester@company.com

GOVERNANCE_LOG_DIR=data/sta_logs
GOVERNANCE_REPORT_DIR=generated_reports
GOVERNANCE_DEFAULT_DAYS=7
GOVERNANCE_DEFAULT_LOG_COUNT=500
GOVERNANCE_USE_FAKE_STA_API=true
GOVERNANCE_PRIVACY_MODE=true
GOVERNANCE_HASH_SALT=CHANGE_ME_DEMO_SALT
GOVERNANCE_SEND_RAW_LOGS_TO_AI=false
GOVERNANCE_MAX_SANITIZED_SAMPLES=20
GOVERNANCE_MASK_IP_MODE=partial
GOVERNANCE_REMOVE_SESSION_IDENTIFIERS=true
