LOCAL_RAG_CHUNK_SIZE=2500

PUBLIC_DOC_LOOKUP_ENABLED=false
PUBLIC_DOC_MAX_URLS=6
PUBLIC_DOC_URLS=
COMBINED_CONTEXT_MAX_CHARS=18000

TICKET_API_MODE=generic
TICKET_API_URL=
